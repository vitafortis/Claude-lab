#!/usr/bin/env bash
# Runs in the sign-in container's tmux pane: signs the agent ($ORB_AGENT) in, with the
# credentials landing in the account's config folder, shared by that account's sessions.
set -u
dim=$'\e[2m'; reset=$'\e[0m'
node /usr/local/lib/orb/seed.mjs || true

case "${ORB_AGENT:-claude}" in
	codex)
		echo "${dim}Signing in to ChatGPT for Codex. Open the link below, sign in, and enter the code.${reset}"
		echo
		codex login --device-auth
		echo
		codex login status
		again="codex login --device-auth"
		;;
	gemini)
		echo "${dim}Signing in to Google for Gemini CLI. Open the link below, approve, and paste the code back here.${reset}"
		echo "${dim}Once Gemini shows its prompt you're signed in; type /quit or close this window.${reset}"
		echo
		NO_BROWSER=true gemini --skip-trust
		again="NO_BROWSER=true gemini"
		;;
	*)
		echo "${dim}Signing in to Claude. Open the link below, approve, and paste the code back here.${reset}"
		echo
		claude auth login
		echo
		claude auth status --text
		again="claude auth login"
		;;
esac
echo
echo "${dim}Done? Close this window in Orbital. To try again, run ${reset}${again}"
exec bash -l
