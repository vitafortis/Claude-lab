# For `pnpm dev` / `pnpm start` outside Docker. In Docker, set these in compose.yaml.

# Where the store and key file live.
CCM_DATA_DIR=./data
# Session data (repos, homes, Claude config). Outside Docker, session containers bind-mount it.
# CCM_SESSIONS_DIR=./data/sessions

# Optional master secret. If unset, a random 256-bit key is written to $CCM_DATA_DIR/secret.key.
# CCM_SECRET_KEY=

# Docker endpoint. Defaults to the local socket.
# CCM_DOCKER_HOST=unix:///var/run/docker.sock

# The image sessions run (Settings can override it).
# CCM_SESSION_IMAGE=ghcr.io/vitafortis/cc-modern-session:latest
# Docker network for session containers (Settings can override it).
# CCM_SESSION_NETWORK=

# When cc·modern can't find its own container to see how /sessions is mounted:
# CCM_SELF_CONTAINER=cc-modern
# CCM_SESSIONS_VOLUME=cc-modern-sessions
# CCM_SESSIONS_HOST_PATH=/srv/cc-modern/sessions

# Label for this install's containers, so two installs can share a Docker host.
# CCM_INSTANCE=cc-modern

# "Sign in with GitHub" (an OAuth app with device flow enabled). PATs work without it.
# CCM_GITHUB_CLIENT_ID=

# Create the login on start instead of using the setup screen.
# CCM_ADMIN_EMAIL=you@example.com
# CCM_ADMIN_PASSWORD=
# CCM_ADMIN_NAME=

# Set to "disabled" to skip the login screen (fully trusted networks only).
# CCM_AUTH=disabled
